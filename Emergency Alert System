1. Emergency Alert System
public class EmergencyAlertSystem {
    private FirebaseMessaging firebaseMessaging;
    private NotificationManager notificationManager;
    
    public void sendBloodRequest(BloodRequest request) {
        // Create notification payload
        Map<String, String> data = new HashMap<>();
        data.put("bloodType", request.getBloodType());
        data.put("location", request.getLocation());
        data.put("urgency", request.getUrgency());
        
        // Send to nearby donors
        NotificationMessage message = NotificationMessage.builder()
            .setData(data)
            .setTitle("Urgent Blood Required: " + request.getBloodType())
            .setBody("Location: " + request.getLocation())
            .build();
            
        firebaseMessaging.send(message);
    }
}
